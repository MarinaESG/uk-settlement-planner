PORT=8780
APP_ORIGIN=http://localhost:8780
# Empty credentials keep all account and payment operations disabled.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Older installations may use SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY.
# The new variable names above take precedence when both are configured.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MONTHLY_PRICE_ID=
STRIPE_DOWNLOAD_PRICE_ID=
# Optional local simulation without Stripe's published Terms URL. Test keys only.
STRIPE_SANDBOX_CHECKOUT=false
# Set true only after completing docs/LAUNCH.md. Production requires HTTPS.
COMMERCE_ENABLED=false
OPERATOR_NAME=
SUPPORT_EMAIL=
